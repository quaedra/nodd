{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nodd-app",
  "account_id": "24448fc5d4c7726e7ed1cdfda7a4dacd",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  // Built by scripts/deploy.sh: dist-site/nodd/ mirrors the URL path. Pages have clean URLs (/nodd/train).
  "assets": { "directory": "./dist-site", "binding": "ASSETS" },
  "routes": [{ "pattern": "quaedra.com/nodd*", "zone_name": "quaedra.com" }]
}
